<div class="flex-list">
	{{range .Repos}}
		<div class="flex-item">
			<div class="flex-item-leading">
				{{template "repo/icon" .}}
			</div>
			<div class="flex-item-main">
				<div class="flex-item-header">
					<div class="flex-item-title">
						{{if and (or $.PageIsExplore $.PageIsProfileStarList) .Owner}}
						<a class="text primary name" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a>/
						{{end}}
						<a class="text primary name" href="{{.Link}}">{{.Name}}</a>
						<span>
							{{if .IsArchived}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.archived"}}</span>
							{{end}}
							{{if .IsPrivate}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.private"}}</span>
							{{else}}
								{{if .Owner.Visibility.IsPrivate}}
									<span class="ui label">{{ctx.Locale.Tr "repo.desc.internal"}}</span>
								{{end}}
							{{end}}
							{{if .IsTemplate}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.template"}}</span>
							{{end}}
							{{if eq .ObjectFormatName "sha256"}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>
							{{end}}
						</span>
					</div>
					<div class="flex-item-trailing muted-links">
						{{if .PrimaryLanguage}}
							<a class="flex-text-inline" href="?q={{$.Keyword}}&sort={{$.SortType}}&language={{.PrimaryLanguage.Language}}{{if $.TabName}}&tab={{$.TabName}}{{end}}">
								<i class="color-icon tw-mr-2" style="background-color: {{.PrimaryLanguage.Color}}"></i>
								{{.PrimaryLanguage.Language}}
							</a>
						{{end}}
						{{if not $.DisableStars}}
							<a class="flex-text-inline" href="{{.Link}}/stars"
								aria-label="{{ctx.Locale.TrPluralString .DisplayNumStars "stars.n_stars" (printf "%d" .DisplayNumStars)}}"
								{{if ge .DisplayNumStars 1000}}
									data-tooltip-content="{{ctx.Locale.TrPluralString .DisplayNumStars "stars.n_stars" (ctx.Locale.PrettyNumber .DisplayNumStars)}}"
								{{end}}
								>
								{{svg "octicon-star" 16}}
								{{CountFmt .DisplayNumStars}}
							</a>
						{{end}}
						{{if not $.DisableForks}}
							<a class="flex-text-inline" href="{{.Link}}/forks"
								aria-label="{{ctx.Locale.TrPluralString .DisplayNumForks "fork.n_forks" (printf "%d" .DisplayNumForks)}}"
								{{if ge .DisplayNumForks 1000}}
									data-tooltip-content="{{ctx.Locale.TrPluralString .DisplayNumForks "fork.n_forks" (ctx.Locale.PrettyNumber .DisplayNumForks)}}"
								{{end}}
								>
								{{svg "octicon-repo-forked" 16}}
								{{CountFmt .DisplayNumForks}}
							</a>
						{{end}}
					</div>
				</div>
				{{$description := .DescriptionHTML $.Context}}
				{{if $description}}
					<div class="flex-item-body">{{$description}}</div>
				{{end}}
				{{if .Topics}}
					<div class="repo-topics">
					{{range .Topics}}
						{{if ne . ""}}<a class="ui label" href="{{AppSubUrl}}/explore/repos?q={{.}}&topic=1">{{.}}</a>{{end}}
					{{end}}
					</div>
				{{end}}
				<div class="flex-item-body">{{ctx.Locale.Tr "org.repo_updated" (DateUtils.TimeSince .UpdatedUnix)}}</div>
			</div>
		</div>
	{{else}}
	<div>
		{{ctx.Locale.Tr "search.no_results"}}
	</div>
	{{end}}
</div>
